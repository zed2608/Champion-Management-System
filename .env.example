# Copy this file to .env on EACH computer and fill in your own values. .env is never committed.
# Server PC: DB_HOST=127.0.0.1.  Client PCs: the server's fixed LAN address.
# Use champion_staff on Staff terminals and champion_admin on Admin workstations (see README.md, python -m db.apply_grants).

DB_HOST=192.168.1.100
DB_PORT=3306
DB_USER=champion_staff
DB_PASS=change-me
DB_NAME=champion_db
