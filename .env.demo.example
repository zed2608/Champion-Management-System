# Copy this file to .env.demo (it is git-ignored) and fill in the MySQL account that may create the demo database.
# Used by scripts/seed_demo_data.py and scripts/run_demo.py. DB_NAME must stay champion_demo (the scripts refuse anything else).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=change-me
DB_NAME=champion_demo
